[Unit]
Description=Room Guardian (LangGraph camera agent)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
User=fuzail
WorkingDirectory=/home/fuzail/room-guardian
Environment=PYTHONUNBUFFERED=1
Environment=LIBCAMERA_LOG_LEVELS=*:ERROR
ExecStart=/usr/bin/python3 /home/fuzail/room-guardian/room_guardian.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
